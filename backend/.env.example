# LLM Config
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
MODEL_NAME="gemini-2.5-flash"

# Storage Locations
UPLOAD_DIR="./storage"
LOG_FILE="./logs/backend.log"
