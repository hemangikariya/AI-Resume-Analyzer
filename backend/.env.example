# API Configuration
PROJECT_NAME="AI Resume Analyzer"
API_V1_STR="/api/v1"
DEBUG=true

# Security
# Run 'openssl rand -hex 32' to generate a real secret key
JWT_SECRET="9a781fbc6c5ea3dbf9b7c89f81d115e5b746c10b42f6fb3bc1d882cf6b5b1ad4"
